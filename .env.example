# Copy to .env and fill in. .env is gitignored — never commit it.

# Power BI (service principal; leave blank in mock mode)
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=
PBI_DATASET_ID=

# Anthropic (model name must come from env — never hardcoded)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 1 = serve fixtures/ instead of the live executeQueries API (default for dev)
MOCK_PBI=1
